matrix1 = [[1, 2], [3, 4]]
matrix2 = [[5, 6], [7, 8]]

print("Matrix Addition:")

for i in range(2):
    for j in range(2):
        print(matrix1[i][j] + matrix2[i][j], end=" ")
    print()

print("Matrix Subtraction:")

for i in range(2):
    for j in range(2):
        print(matrix1[i][j] - matrix2[i][j], end=" ")
    print()